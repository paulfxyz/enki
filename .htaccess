# Enki — locale-prefixed canonical URLs, fresh HTML, versioned assets
Options -MultiViews -Indexes
DirectoryIndex index.html
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteOptions AllowNoSlash

  # The router validates slugs and redirects legacy/query/trailing-slash URLs.
  # Assets and the existing API are outside these rules.
  RewriteRule ^$ router.php [END]
  RewriteRule ^(?:en|fr|zh|hi|es|ar|bn|pt|ru|ur|id|de|ja|ko|vi|tr|it|pl|nl|he)(?:/.*)?$ router.php [END]
  RewriteRule ^(?:index|manifesto|client|standard|models|registry|device|institute|join|300|simple|apply|privacy)(?:\.html)?/?$ router.php [END]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|svg)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>
